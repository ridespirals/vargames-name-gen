# IGDB (Twitch) API credentials. Get these from the Twitch Developer Console.
# Do not commit .env or any file containing real values.

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: override IGDB API base URL (default: https://api.igdb.com/v4)
# IGDB_BASE_URL=https://api.igdb.com/v4

# Optional: pre-generated IGDB access token (if you are not using client-credentials flow)
# IGDB_ACCESS_TOKEN=

# Optional: default max "limit" to use in IGDB queries (mirrors bruno prod max_limit, default 500)
# IGDB_MAX_LIMIT=500

# Optional: enable progress logging for IGDB client and fetchers (1, true, on). Or use -verbose flag.
# IGDB_VERBOSE=
